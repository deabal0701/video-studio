            "num": "1", "title": "처음 켰을 때", "subtitle": "첫 실행 안내",
            "brand": "#3b9dff", "brandSoft": "#9ecbff", "bg": "#0d1117",
            "fontUrl": "../fonts/PretendardVariable.woff2", "wipe": "off"
          }
