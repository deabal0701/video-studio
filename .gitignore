# 산출물 — 파생물 (언제든 재생성)
**/out/
*.mp4
*.webm

# 소재 미디어 — 무료 스톡 재배포 금지 (CATALOG.md·fetch.js 만 추적)
engine/assets/bgm/*
engine/assets/broll/*
engine/assets/photo/*
engine/assets/presenter/*
!engine/assets/**/.gitignore

# 비밀
.env
!.env.sample

# 패키징 산출물 (1.3GB — 재생성 가능)
dist/
build/
packaging/out/
packaging/licenses/

# 런타임
node_modules/
__pycache__/
*.pyc
.venv/
.qt-venv/
venv/

# 개발 모드의 데이터 폴더 — 담당자가 만든 강좌가 쌓이는 곳이지 소스가 아니다.
# (동결본은 <data>/projects 를 쓴다. 재현용 정본은 fixtures/projects/ 다)
projects/

# 파생 캐시
*.sqlite
*.sqlite3
.cache/

# OS
.DS_Store
